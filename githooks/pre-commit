#!/bin/sh
# aquila-hooks dispatcher v1 — shared by aquila-ai, aquila-react-ai and aquila-next-ai; written by
# `npx <package> init`, do not edit. For each "<package> <dir>" in .aquila-hooks/projects with changes under
# <dir>, runs `<package> gate <phase>` inside <dir> (staged files for pre-commit, pushed commits for pre-push).
set -f
phase=$(basename "$0")
top=$(git rev-parse --show-toplevel) || exit 1
cd "$top" || exit 1
[ -f .aquila-hooks/projects ] || exit 0
nl='
'
if [ "$phase" = pre-push ]; then
  files=
  while read -r _lref lsha _rref _rsha; do
    case "$lsha" in '' | *[!0]*) ;; *) continue ;; esac # branch deletion: nothing to check
    [ -n "$lsha" ] || continue
    files="$files$nl$(git log --name-only --format= "$lsha" --not --remotes 2>/dev/null)"
  done
else
  files=$(git diff --cached --name-only)
fi
projects=$(tr -d '\r' <.aquila-hooks/projects)
status=0
while read -r pkg dir; do
  case "$pkg" in '' | '#'*) continue ;; esac
  [ -n "$dir" ] || dir=.
  hit=
  IFS=$nl
  for f in $files; do
    case "$dir" in .) hit=1 ;; *) case "$f" in "$dir"/*) hit=1 ;; esac ;; esac
    [ -n "$hit" ] && break
  done
  unset IFS
  [ -n "$hit" ] || continue
  bin="$dir/node_modules/$pkg/bin/aquila.mjs"
  if [ ! -f "$bin" ]; then
    echo "aquila-hooks: $bin not found — install the dependencies in $dir (e.g. npm install)" >&2
    status=1
    continue
  fi
  echo "aquila-hooks: $pkg gate $phase ($dir)"
  (cd "$dir" && node "node_modules/$pkg/bin/aquila.mjs" gate "$phase" </dev/null) || status=1
done <<EOF_PROJECTS
$projects
EOF_PROJECTS
exit $status
